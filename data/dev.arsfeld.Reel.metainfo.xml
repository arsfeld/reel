<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.arsfeld.Reel</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Reel</name>
  <summary>A modern, native media player for the Linux desktop</summary>

  <developer id="dev.arsfeld">
    <name>Alexandre Rosenfeld</name>
  </developer>

  <description>
    <p>
      Reel is a beautiful media player for the Linux desktop with Plex
      integration, automatic metadata, and universal format support
      powered by mpv.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Hardware-accelerated video playback via mpv</li>
      <li>Plex media server integration with OAuth</li>
      <li>Beautiful library browsing with poster art</li>
      <li>Resume playback from where you left off</li>
      <li>MPRIS desktop media controls</li>
    </ul>
  </description>

  <launchable type="desktop-id">dev.arsfeld.Reel.desktop</launchable>

  <url type="homepage">https://github.com/arsfeld/reel</url>
  <url type="bugtracker">https://github.com/arsfeld/reel/issues</url>

  <content_rating type="oars-1.1" />

  <requires>
    <control>keyboard</control>
    <control>pointing</control>
  </requires>

  <provides>
    <binary>reel</binary>
    <mediatype>video/mp4</mediatype>
    <mediatype>video/x-matroska</mediatype>
    <mediatype>video/webm</mediatype>
    <mediatype>video/mpeg</mediatype>
    <mediatype>video/quicktime</mediatype>
  </provides>

  <releases>
    <release version="0.1.0" date="2026-03-14">
      <description>
        <p>Initial release with Plex integration and mpv playback.</p>
      </description>
    </release>
  </releases>
</component>
